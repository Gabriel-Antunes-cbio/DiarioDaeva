# Copie para bot/.env e preencha. Este arquivo .env NUNCA vai para o GitHub.

# Token do bot (Discord Developer Portal → Bot → Reset Token)
DISCORD_TOKEN=

# ID do servidor do Discord (deixa os comandos aparecerem na hora)
GUILD_ID=

# ID do canal onde o bot avisa os respawns
CHANNEL_ID=

# Quem o aviso de respawn marca (escolha UM dos dois; se os dois estiverem vazios, ninguém é notificado):
#  - ALERT_MENTION=everyone  marca @everyone (todos do servidor)
#  - ALERT_MENTION=here      marca @here (só quem está online)
#  - ROLE_ID=<id do cargo>   marca só quem tem o cargo (ex.: @Bosses)
# Para @everyone/@here o bot precisa da permissão "Mencionar @everyone, @here e todos os cargos" no canal.
ALERT_MENTION=
ROLE_ID=

# Chave do grupo: uma senha longa que você passa só para os amigos colarem no app
# Gere uma com:  python3 -c "import secrets; print(secrets.token_urlsafe(24))"
GROUP_KEY=

# Porta da API do app
PORT=8080

# Fuso dos horários digitados nos comandos (servidores da América Latina = Brasília)
TZ_NAME=America/Sao_Paulo

# Minutos de antecedência do aviso no canal
ALERT_MINUTES=5
